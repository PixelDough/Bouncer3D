  m_TableData:
  - m_Id: 32626434048
    m_Localized: Hold JUMP when hitting walls to gain extra verticality
    m_Metadata:
      m_Items: []
  - m_Id: 734098612224
    m_Localized: NO TEXT
    m_Metadata:
      m_Items: []
  - m_Id: 8281434087424
    m_Localized: 'To bounce high, jump as late as possible.

      More upward speed
      = higher bounce'
    m_Metadata:
      m_Items: []
  - m_Id: 17139174989824
    m_Localized: 'Bounce back and forth between walls to climb.

      Pass through
      the ceiling to continue'
    m_Metadata:
      m_Items: []
  - m_Id: 40650652246016
    m_Localized: Straight walls aren't the only things you can bounce off of
    m_Metadata:
      m_Items: []
  - m_Id: 1513194890715136
    m_Localized: Press JUMP to close
    m_Metadata:
      m_Items: []
  - m_Id: 1878555582521344
    m_Localized: For this demo, you can quit a level at any time by holding down
      Esc/Start
    m_Metadata:
      m_Items:
      - rid: 4297556070518751325
